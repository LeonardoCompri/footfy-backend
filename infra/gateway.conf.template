# Rota do Footfy no portao da Analitix (gerado pelo infra/setup.sh do footfy)
location = __BASE_PATH__ {
    return 301 __BASE_PATH__/;
}

location __BASE_PATH__/ {
    # A barra no final remove o prefixo: __BASE_PATH__/api/x chega como /api/x
    proxy_pass http://127.0.0.1:__WEB_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 12m;
}
